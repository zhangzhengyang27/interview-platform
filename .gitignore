# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# 用户上传资源（头像等，运行时生成，不入库）
/public/uploads/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 放行示例文件，使其可以入库供协作者参考变量结构
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/scripts

# local / temporary
.trae/
tmp/
screenshots/
shot-*.png
sql 备份/
fetch_all_questions.js
prisma/seed.sql

# data backups
backups/

# worktrees
.worktrees/

# codebuddy 项目数据
.codebuddy/
