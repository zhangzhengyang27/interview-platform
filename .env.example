# =============================================================================
# 面试网 - 环境变量配置示例
# 复制此文件为 .env.local 并填入真实值
# =============================================================================

# ---- 数据库 ----
# PostgreSQL 数据库连接字符串
DATABASE_URL="postgresql://postgres:password@localhost:5432/interview_platform?schema=public"

# ---- AI / DeepSeek ----
# DeepSeek API Key（用于 AI 对话、出题、模拟面试评估）
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY="sk-your-deepseek-api-key-here"

# ---- 火山引擎豆包语音（语音面试：ASR 语音识别 + TTS 语音合成）----
# 新版控制台采用 API Key 鉴权（X-Api-Key 请求头）
# 获取地址：https://console.volcengine.com/speech/app -> API Key 管理
VOLC_API_KEY="your-volc-api-key"
# TTS 资源模型（固定值）
VOLC_TTS_RESOURCE_ID="seed-tts-2.0"
# ASR 资源模型（豆包流式语音识别模型1.0 小时版；如已开通 2.0 可改为 volc.seedasr.sauc.duration）
VOLC_ASR_RESOURCE_ID="volc.bigasr.sauc.duration"
# TTS 音色（豆包语音合成模型2.0 音色）
VOLC_TTS_VOICE_TYPE="zh_female_shuangkuaisisi_uranus_bigtts"

# ---- 火山引擎 SeedRealtime（视频面试 = RTC 通道 + 豆包端到端实时语音大模型）----
# 1) 豆包端到端实时语音大模型凭证（语音控制台 AppId + AccessToken，旧版鉴权）
# 获取地址：https://console.volcengine.com/speech/app
VOLC_S2S_APP_ID="your-s2s-app-id"
VOLC_S2S_ACCESS_TOKEN="your-s2s-access-token"
# 2) RTC「AI 音视频互动方案」应用凭证
# 获取地址：https://console.volcengine.com/rtc -> 应用管理
VOLC_RTC_APP_ID="your-rtc-app-id"
VOLC_RTC_APP_KEY="your-rtc-app-key"
# 3) 火山引擎账号级 AK/SK（调用 StartVoiceChat OpenAPI 的 V4 签名）
# 获取地址：https://console.volcengine.com/iam/keymanage/
VOLC_ACCESS_KEY="your-volc-access-key"
VOLC_SECRET_KEY="your-volc-secret-key"

# ---- 阿里云 OSS（可选 - 仅在需要图片上传功能时配置）----
# OSS 区域（如：oss-cn-nanjing）
OSS_REGION="oss-cn-nanjing"
# OSS Bucket 名称
OSS_BUCKET="your-bucket-name"
# OSS hostname（用于 next/image 远程图片配置）
OSS_HOSTNAME="your-bucket.oss-cn-nanjing.aliyuncs.com"
# RAM 子账号 AccessKey
OSS_ACCESS_KEY_ID="your-access-key-id"
OSS_ACCESS_KEY_SECRET="your-access-key-secret"
# STS 角色 ARN（用于生成临时上传凭证）
OSS_ROLE_ARN="acs:ram::1234567890123456:role/your-sts-role"

# ---- NextAuth 认证（NextAuth v5 使用 AUTH_ 前缀）----
# Auth Secret（用于签名 Session Token，必须设置为至少 32 位的随机字符串）
# 生成方式：openssl rand -hex 32
AUTH_SECRET="your-long-random-secret-string"
# Auth URL（开发环境使用 http://localhost:3000，生产环境使用你的域名）
AUTH_URL="http://localhost:3000"

# GitHub OAuth（可选 - 用于 GitHub 登录）
# 申请地址：https://github.com/settings/developers
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# ---- 站点信息 ----
# 站点公开访问地址（用于生成 sitemap.xml 和 robots.txt，生产环境必填）
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ---- 时区 ----
TZ="Asia/Shanghai"
